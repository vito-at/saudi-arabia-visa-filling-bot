# Автоматический HTTPS (Let's Encrypt) для CRM. Домен берётся из переменной DOMAIN.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Страница-визитка для Instagram (замена Taplink): links/index.html из репозитория.
# Домен — LINKS_DOMAIN в .env, по умолчанию link.orienttravel.uz. Нужна A-запись на IP этого сервера.
{$LINKS_DOMAIN:link.orienttravel.uz} {
	encode zstd gzip
	root * /srv/links
	rewrite * /index.html
	file_server
	header {
		Cache-Control "public, max-age=300"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Сайт проверки документов по QR-коду для Ипотека-банка — отдельный проект (репозиторий vito-at/qr-code-creator),
# работает на этом же сервере в своём контейнере, подключённом к сети CRM под именем qr-code-app.
# Домен — VERIFY_DOMAIN в .env, по умолчанию hujjat-ipotekabank.uz. Нужна A-запись на IP этого сервера.
# Пока контейнер не запущен, по этому домену будет ошибка 502; на CRM это не влияет.
{$VERIFY_DOMAIN:hujjat-ipotekabank.uz} {
	encode zstd gzip
	reverse_proxy qr-code-app:3000
	header Strict-Transport-Security "max-age=31536000"
}
