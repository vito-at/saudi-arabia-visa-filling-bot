# Автоматический HTTPS (Let's Encrypt) для CRM. Домен берётся из переменной DOMAIN.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Страница-визитка для Instagram (замена Taplink): links/index.html из репозитория.
# Домен — LINKS_DOMAIN в .env, по умолчанию link.orienttravel.uz. Нужна A-запись на IP этого сервера.
{$LINKS_DOMAIN:link.orienttravel.uz} {
	encode zstd gzip
	root * /srv/links
	rewrite * /index.html
	file_server
	header {
		Cache-Control "public, max-age=300"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
