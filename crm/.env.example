# ─── База данных ────────────────────────────────────────────────────────────
# Для docker compose эти значения используются контейнером PostgreSQL;
# DATABASE_URL для контейнеров app/worker собирается в docker-compose.yml автоматически.
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=crm
# Строка подключения для запуска на хосте (npm run dev, prisma migrate, seed)
DATABASE_URL="postgresql://crm:change-me-strong-password@localhost:5432/crm?schema=public"

# ─── Приложение ─────────────────────────────────────────────────────────────
# Публичный адрес CRM (нужен для ссылки вебхука в настройках интеграции)
APP_URL="https://crm.example.uz"
# Домен для автоматического HTTPS через Caddy (docker compose --profile https)
DOMAIN="crm.example.uz"
TZ="Asia/Tashkent"

# ─── Авторизация (Auth.js) ─────────────────────────────────────────────────
# Сгенерируйте: openssl rand -base64 32
AUTH_SECRET="replace-with-random-32-bytes"
# Доверять заголовкам прокси (Caddy/Nginx) — нужно за reverse proxy
AUTH_TRUST_HOST=true

# ─── Шифрование секретов интеграции (App Secret, токены) ───────────────────
# 64 hex-символа. Сгенерируйте: openssl rand -hex 32
# ВНИМАНИЕ: при смене ключа сохранённые токены придётся ввести заново.
ENCRYPTION_KEY="replace-with-64-hex-chars"

# ─── Meta Graph API ────────────────────────────────────────────────────────
# Версия Graph API (актуальная стабильная на 30.09.2026 — v26.0)
META_GRAPH_VERSION="v26.0"
# Адрес Graph API — менять только для тестов с mock-сервером
# META_GRAPH_URL="https://graph.facebook.com"

# ─── Курс USD (Ипак Йули Банк) ─────────────────────────────────────────────
# Открытые страницы с курсом, через запятую; перебираются по очереди.
# IPAK_RATE_URLS="https://ipakyulibank.uz/physical/exchange-rates,https://bank.uz/currency/bank/ipakyulibank,https://depozit.uz/ru/exchange-rate-bank/ipak-yoli-banki"

# ─── Первичное заполнение (npm run db:seed) ────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-password
# Тестовые данные: ~100 лидов, сделки, отказы, расходы. Для боевого запуска — false
SEED_DEMO=true
SEED_DEMO_COUNT=100
