generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  /// визовый специалист: видит только переданные ему визовые заявки
  VISA
}

enum LeadSource {
  META_FB
  META_IG
  CALL
  INSTAGRAM_DIRECT
  TELEGRAM
  WALK_IN
  /// заявка с сайта агентства
  WEBSITE
  OTHER
}

enum ServiceType {
  FLIGHTS
  TOUR
  VISA
  OTHER
}

enum Currency {
  UZS
  USD
}

/// Тип статуса — от него зависит логика (сделка, причина отказа, подсветка новых),
/// поэтому статусы можно свободно переименовывать.
/// От чего считается процент менеджера: от суммы продаж или от прибыли
enum CommissionBase {
  REVENUE
  PROFIT
}

enum StatusKind {
  NEW
  IN_PROGRESS
  /// «Перезвонить»: при выборе обязательно указать дату и время звонка
  CALLBACK
  WON
  LOST
  OTHER
}

enum SyncTrigger {
  CRON
  MANUAL
  WEBHOOK
}

enum RateSource {
  MANUAL
  IPAK_YULI
}

enum DistributionMode {
  MANUAL
  ROUND_ROBIN
}

model User {
  id             String    @id @default(cuid())
  login          String    @unique
  passwordHash   String
  name           String
  role           Role      @default(MANAGER)
  isActive       Boolean   @default(true)
  lastAssignedAt DateTime?
  /// «В работе»: при автораспределении лиды получают только менеджеры на смене; через час без действий в CRM выключается само
  onShift        Boolean   @default(false)
  /// последнее действие менеджера в CRM (нажатие, ввод текста) — для автоотключения «В работе» и учёта часов работы
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  /// Зарплата: оклад в месяц, процент от суммы продаж (или прибыли) своих сделок и надбавка к проценту при выполнении плана по прибыли
  salaryBase     Decimal        @default(1500000) @db.Decimal(18, 2)
  salaryCurrency Currency       @default(UZS)
  commissionPct  Decimal        @default(5) @db.Decimal(5, 2)
  commissionFrom CommissionBase @default(REVENUE)
  planBonusPct   Decimal   @default(0) @db.Decimal(5, 2)

  leads         Lead[]         @relation("LeadManager")
  deals         Deal[]
  dealPayments  DealPayment[]
  chatMessages  ChatMessage[]
  plans         ManagerPlan[]
  salaryTerms   SalaryTerm[]
  salaryRules   SalaryRule[]
  visaCountries VisaCountry[]  @relation("VisaCountryEditor")
  visaVerified  VisaCountry[]  @relation("VisaCountryVerifier")
  salaryPaid    SalaryPayout[] @relation("PayoutManager")
  shiftDays     ShiftDay[]
  salaryPaidBy  SalaryPayout[] @relation("PayoutAuthor")
  telegram      TelegramAccount?
  notifications Notification[]
  comments      Comment[]
  history       LeadHistory[]
  tasks         Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")
  expenses      Expense[]
  /// визовые заявки, которые ведёт визовый специалист
  visaServices  LeadService[]  @relation("ServiceAssignee")
  documents     LeadDocument[]
  visaEvents    VisaEvent[]
}

model LeadStatus {
  id       String     @id @default(cuid())
  name     String
  color    String     @default("#64748b")
  order    Int
  kind     StatusKind @default(OTHER)
  isSystem Boolean    @default(false)
  /// false — статус-попытка (не дозвонились, перезвонить): не является этапом воронки продаж
  inFunnel Boolean    @default(true)
  /// true — при переходе в этот статус лид теряет ответственного и попадает в общий список («Не дозвонились»);
  /// следующий менеджер, сменивший статус, становится ответственным
  toPool   Boolean    @default(false)

  leads Lead[]
}

model LossReason {
  id       String  @id @default(cuid())
  name     String
  order    Int
  isActive Boolean @default(true)

  leads Lead[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  createdAt DateTime @default(now())

  leads Lead[]
  deals Deal[]
}

model Lead {
  id                 String       @id @default(cuid())
  leadgenId          String?      @unique
  source             LeadSource
  name               String
  phone              String?
  phoneRaw           String?
  email              String?
  clientId           String
  isRepeat           Boolean      @default(false)
  statusId           String
  managerId          String?
  /// Лид создан администратором вручную: пока нет ответственного, менеджеры его не видят
  hiddenFromManagers Boolean      @default(false)
  serviceType        ServiceType?
  destination        String?
  travelFrom         DateTime?
  travelTo           DateTime?
  travelers          Int?
  /// Количество заявлений на визу (для «Визовой поддержки») — для отчёта «Визы»
  visaApplications   Int?
  /// Кастомные ответы формы: [{ key, label, value }]
  formAnswers        Json?

  formId       String?
  formName     String?
  campaignId   String?
  campaignName String?
  adsetId      String?
  adsetName    String?
  adId         String?
  adName       String?
  platform     String?
  /// Органический лид Meta (форму заполнили не из показа рекламы, а из репоста или поста в профиле): в Ads Manager не считается. null — неизвестно
  isOrganic    Boolean?

  lossReasonId String?
  lossComment  String?

  /// Когда перезвонить (для статуса «Перезвонить»)
  callbackAt DateTime?

  metaCreatedAt   DateTime?
  /// ответы анкеты клиента: { [id вопроса]: значение }
  profile         Json?
  /// когда создана задача «Спросить, как прошла поездка» (по дате возвращения из анкеты)
  tripFollowUpAt  DateTime?
  /// ссылка на подборку туров для клиента: /o/{offersToken}
  offersToken     String?   @unique
  createdAt       DateTime  @default(now())
  assignedAt      DateTime?
  firstResponseAt DateTime?
  statusChangedAt DateTime  @default(now())

  client     Client      @relation(fields: [clientId], references: [id])
  status     LeadStatus  @relation(fields: [statusId], references: [id])
  manager    User?       @relation("LeadManager", fields: [managerId], references: [id])
  lossReason LossReason? @relation(fields: [lossReasonId], references: [id])

  comments      Comment[]
  history       LeadHistory[]
  tasks         Task[]
  deals         Deal[]
  conversations Conversation[]
  offers        TourOffer[]
  services      LeadService[]
  documents     LeadDocument[]
  conversions   ConversionEvent[]

  @@index([statusId])
  @@index([managerId])
  @@index([createdAt])
  @@index([phone])
  @@index([campaignId])
  @@index([clientId])
  @@index([callbackAt])
}

model Comment {
  id        String    @id @default(cuid())
  leadId    String
  authorId  String
  text      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

model LeadHistory {
  id         String   @id @default(cuid())
  leadId     String
  /// null — действие системы (синхронизация, автораспределение)
  userId     String?
  field      String
  oldValue   String?
  newValue   String?
  toStatusId String?
  createdAt  DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([toStatusId])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  assigneeId  String
  createdById String
  title       String
  dueAt       DateTime
  doneAt      DateTime?
  /// Задача создана статусом «Перезвонить» и закрывается при смене статуса
  isCallback  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lead      Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee  User  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, doneAt, dueAt])
}

model Deal {
  id            String    @id @default(cuid())
  leadId        String
  clientId      String
  managerId     String?
  amount        Decimal   @db.Decimal(18, 2)
  cost          Decimal   @db.Decimal(18, 2)
  /// валюта суммы продажи
  currency      Currency
  /// валюта себестоимости (может отличаться от валюты продажи)
  costCurrency  Currency
  paidAt        DateTime
  product       String
  /// тип услуги сделки (авиабилеты, тур, виза…) — от него зависит комиссия менеджера
  serviceType   ServiceType?
  /// Количество продаж в сделке (для визы — число заявлений); меняет только администратор
  quantity      Int       @default(1)
  /// false — сделку закрыл менеджер, себестоимость ещё не указал администратор
  costConfirmed Boolean   @default(true)
  /// Сколько клиент заплатил (в валюте продажи). Учёт долгов убран (10.2026): новые сделки — вся сумма; колонка оставлена для старых данных
  paidAmount    Decimal   @default(0) @db.Decimal(18, 2)
  /// До какого числа клиент обещал доплатить (не используется с 10.2026, старые данные)
  dueAt         DateTime?
  /// Заметка по долгу (не используется с 10.2026, старые данные)
  debtNote      String?
  createdAt     DateTime  @default(now())

  lead     Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id])
  manager  User?         @relation(fields: [managerId], references: [id])
  payments DealPayment[]

  @@index([paidAt])
  @@index([clientId])
  @@index([costConfirmed])
}

/// Оплата по сделке (предоплата и доплаты долга), в валюте сделки. Не используется с 10.2026 — таблица оставлена для старых данных
model DealPayment {
  id        String   @id @default(cuid())
  dealId    String
  amount    Decimal  @db.Decimal(18, 2)
  paidAt    DateTime
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  deal Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dealId])
}

model MetaIntegration {
  id              Int       @id @default(1)
  appId           String?
  appSecretEnc    String?
  pageId          String?
  pageTokenEnc    String?
  verifyToken     String?
  /// Рекламный кабинет (act_XXXX) и отдельный токен Marketing API с правом ads_read — для расходов
  adAccountId     String?
  adsTokenEnc     String?
  /// За сколько дней загружать лиды при первой синхронизации (Meta хранит лиды 90 дней)
  initialDays     Int       @default(30)
  pollIntervalMin Int       @default(5)
  enabled         Boolean   @default(false)
  lastSyncAt      DateTime?
  /// Загрузка лидов идёт до этого момента (блокировка от параллельных запусков; зависшая снимается сама по сроку)
  syncLockedUntil DateTime?
  lastSpendSyncAt DateTime?
  tokenValid      Boolean   @default(true)
  tokenError      String?
  tokenExpiresAt  DateTime?
  /// Conversions API для CRM: набор данных (Dataset) в Events Manager и его маркер доступа —
  /// CRM сообщает Meta, что стало с лидом из формы (квалифицирован / продажа / отказ)
  capiDatasetId   String?
  capiTokenEnc    String?
  /// Код тестовых событий из Events Manager (вкладка «Тестовые события»); пусто — боевой режим
  capiTestCode    String?
  capiEnabled     Boolean   @default(false)
  capiLastError   String?
  capiLastSentAt  DateTime?
  /// Переписка Instagram Direct: принимать сообщения, аккаунт Instagram, привязанный к странице
  igEnabled       Boolean   @default(false)
  igAccountId     String?
  igUsername      String?
  igLastEventAt   DateTime?
}

enum ConversionStatus {
  PENDING
  SENT
  FAILED
}

/// Событие воронки для Meta Conversions API: каждая стадия отправляется по лиду один раз
model ConversionEvent {
  id        String           @id @default(cuid())
  leadId    String
  leadgenId String
  eventName String
  eventTime DateTime         @default(now())
  /// сумма продажи (для «Converted») в USD
  value     Decimal?         @db.Decimal(14, 2)
  status    ConversionStatus @default(PENDING)
  attempts  Int              @default(0)
  error     String?
  sentAt    DateTime?
  updatedAt DateTime         @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, eventName])
  @@index([status])
}

/// Лиды Meta, удалённые администратором: не загружаем их повторно при синхронизации
model DeletedLeadgen {
  leadgenId String   @id
  deletedAt DateTime @default(now())
}

model MetaForm {
  id         String    @id
  name       String
  status     String?
  lastLeadAt DateTime?
}

model SyncLog {
  id           String      @id @default(cuid())
  trigger      SyncTrigger
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  formsChecked Int         @default(0)
  fetched      Int         @default(0)
  created      Int         @default(0)
  duplicates   Int         @default(0)
  ok           Boolean     @default(true)
  error        String?

  @@index([startedAt])
}

model AdSpend {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  campaignId   String
  adsetId      String   @default("")
  adId         String   @default("")
  spend        Decimal  @db.Decimal(18, 2)
  currency     String
  /// Показы и клики по ссылке (Marketing API insights)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  campaignName String?
  adsetName    String?
  adName       String?

  @@unique([date, campaignId, adsetId, adId])
}

model AppSettings {
  id                  Int              @id @default(1)
  distributionMode    DistributionMode @default(MANUAL)
  unprocessedAlertMin Int              @default(15)
  /// с этого момента CRM считает зарплату (комиссию с продаж и оклад); раньше — расчёты вели вне CRM
  salaryStartAt       DateTime?
  /// авиабилеты: процент от чистой прибыли, который делится поровну между менеджерами «В работе» в день продажи;
  /// каждая получает свою долю только с билетов, проданных ею самой
  flightPoolPct       Decimal          @default(30) @db.Decimal(5, 2)
  /// Себестоимость визы в Таиланд за одно заявление, $: подставляется в визовую сделку автоматически (0 — не подставлять)
  thaiVisaCostUsd     Decimal          @default(48) @db.Decimal(18, 2)
  /// автораспределение: сколько необработанных (статус «Новый») лидов одновременно может быть у менеджера
  leadLimit           Int              @default(5)
  /// Курс продажи $ (банк покупает доллары, дешёвый) — по нему пересчитывается выручка
  usdRate             Decimal          @default(12800) @db.Decimal(12, 2)
  /// Курс покупки $ (банк продаёт доллары, дорогой) — по нему пересчитываются себестоимость, реклама и расходы компании
  usdRateCost         Decimal          @default(12800) @db.Decimal(12, 2)
  usdRateSource       RateSource       @default(IPAK_YULI)
  usdRateUpdatedAt    DateTime?
  usdRateError        String?
  /// Рабочее время офиса (минуты от полуночи по Ташкенту) и рабочие дни (1 — пн … 7 — вс):
  /// по нему считается скорость реакции на лид — ночные и выходные часы не идут в счёт
  workStartMin        Int              @default(540)
  workEndMin          Int              @default(1080)
  workDays            Int[]            @default([1, 2, 3, 4, 5, 6])
  /// ключ API для заявок с сайта (хранится хэш; сам ключ показывается один раз при создании)
  siteApiKeyHash      String?
  /// сайт Orient Visa: адрес, ключ для загрузки анкет (Bearer) и секрет подписи событий — те же, что на сайте
  orientVisaUrl       String?
  orientVisaKeyEnc    String?
  orientVisaSecretEnc String?
}

/// История курсов USD→UZS по дням: суммы пересчитываются по курсу дня операции, поэтому отчёты за прошлые даты не меняются
model ExchangeRate {
  /// ташкентская дата
  date      DateTime @id @db.Date
  /// курс продажи $ — выручка
  sale      Decimal  @db.Decimal(12, 2)
  /// курс покупки $ — себестоимость, реклама, расходы компании
  cost      Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

/// Расходы компании (аренда, зарплаты, налоги и т. п.) — вносит администратор в разделе «Финансы»
model Expense {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  category    String
  amount      Decimal  @db.Decimal(18, 2)
  currency    Currency
  note        String?
  /// «Взял себе из кассы» — деньги владельца, не расход компании: не вычитаются из чистой прибыли, показываются отдельно
  ownerDraw   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
}

enum ChatChannel {
  INSTAGRAM
  TELEGRAM
}

enum ChatDirection {
  IN
  OUT
}

/// Переписка с клиентом в мессенджере (Instagram Direct или Telegram)
model Conversation {
  id                   String      @id @default(cuid())
  channel              ChatChannel
  /// Instagram: IGSID собеседника; Telegram: id чата
  externalId           String
  /// Telegram Business: чат личного аккаунта, подключённого к боту — ответ уходит от имени аккаунта
  businessConnectionId String?
  /// личный Telegram сотрудника, через который идёт переписка: её видят только он (и администратор — переписки сотрудников)
  accountId            String?
  /// ключ уникальности: id аккаунта сотрудника или "" (Instagram, сам бот) — один клиент может писать нескольким сотрудникам
  scope                String      @default("")
  title                String
  username             String?
  avatarUrl            String?
  leadId               String?
  lastMessageAt        DateTime    @default(now())
  lastMessageText      String?
  /// последнее сообщение клиента — у Instagram ответить можно в течение 24 часов после него
  lastInboundAt        DateTime?
  unreadCount          Int         @default(0)
  createdAt            DateTime    @default(now())
  /// ИИ-ассистент молчит: ответил менеджер, ассистент передал диалог или его выключили в переписке
  aiPaused             Boolean     @default(false)
  aiReplies            Int         @default(0)
  /// пока ассистент готовит ответ — второй обработчик эту переписку не берёт
  aiLockedUntil        DateTime?
  /// последнее входящее, на которое ассистент уже ответил (или решил промолчать) — повторно не спрашиваем модель
  aiAnsweredAt         DateTime?

  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  account  TelegramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@unique([channel, externalId, scope])
  @@index([accountId])
  @@index([lastMessageAt])
  @@index([leadId])
}

model ChatMessage {
  id             String        @id @default(cuid())
  conversationId String
  direction      ChatDirection
  text           String?
  /// вложения: [{ type: "image" | "audio" | "video" | "file" | "sticker", url?, fileId?, name? }]
  attachments    Json?
  /// id сообщения в мессенджере (Instagram mid, Telegram message_id) — защита от дублей
  externalId     String?
  /// кто из сотрудников отправил (для исходящих из CRM)
  senderId       String?
  /// ошибка отправки
  error          String?
  /// ответ ИИ-ассистента
  isAi           Boolean       @default(false)
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
}

/// Telegram-бот для переписки с клиентами (и Telegram Business — чаты личного аккаунта)
model TelegramIntegration {
  id                   Int       @id @default(1)
  botTokenEnc          String?
  botUsername          String?
  /// секрет заголовка X-Telegram-Bot-Api-Secret-Token — вебхук принимает только запросы Telegram
  webhookSecret        String?
  enabled              Boolean   @default(false)
  lastError            String?
  lastEventAt          DateTime?
  /// подключение Telegram Business (личный аккаунт агентства → бот)
  businessConnectionId String?
  businessUser         String?
}

/**
 * Личный Telegram сотрудника, подключённый к боту CRM через Telegram Business. Привязка: сотрудник открывает ссылку
 * t.me/<бот>?start=<код> из своего Telegram (так CRM узнаёт его Telegram id), затем подключает бота в настройках
 * Telegram Business. Подключения от непривязанных аккаунтов отклоняются.
 */
model TelegramAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  /// Telegram id владельца аккаунта — после /start с кодом
  tgUserId     String?   @unique
  tgName       String?
  tgUsername   String?
  /// одноразовый код привязки и время его выдачи (действует час)
  linkCode     String?   @unique
  linkCodeAt   DateTime?
  /// подключение Telegram Business: id, включено ли, можно ли отвечать от имени аккаунта
  connectionId String?   @unique
  connected    Boolean   @default(false)
  canReply     Boolean   @default(false)
  connectedAt  DateTime?
  /// новые собеседники становятся лидами этого сотрудника (личному аккаунту владельца можно выключить)
  createLeads  Boolean   @default(true)
  /// ИИ-ассистент отвечает в переписках этого аккаунта
  aiEnabled    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

enum QuestionType {
  TEXT
  NUMBER
  DATE
  SELECT
}

/// Особая роль вопроса анкеты: даты поездки записываются в лид (travelFrom / travelTo) — по дате возвращения CRM напоминает спросить про поездку
enum QuestionRole {
  DEPART_DATE
  RETURN_DATE
}

/// Вопрос анкеты клиента в карточке лида (настраивает администратор)
model LeadQuestion {
  id       String        @id @default(cuid())
  label    String
  type     QuestionType  @default(TEXT)
  /// варианты для SELECT
  options  String[]      @default([])
  role     QuestionRole? @unique
  order    Int
  isActive Boolean       @default(true)
}

/// План менеджера на месяц: лиды, продажи (по количеству), прибыль в долларах
model ManagerPlan {
  id     String   @id @default(cuid())
  userId String
  /// первое число месяца
  month  DateTime @db.Date
  leads  Int?
  sales  Int?
  profit Decimal? @db.Decimal(18, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

/// Фиксированная оплата всем менеджерам за каждую проданную единицу услуги (для визы — за каждое заявление, по количеству
/// в сделке), например 5 $ за визу в ОАЭ — вместо процента с этих сделок. Действует для сделок, оплаченных с fromDate.
/// Особый процент менеджера (SalaryRule) для той же услуги важнее.
model SalesBonus {
  id          String      @id @default(cuid())
  serviceType ServiceType
  /// страна визы (русское название из VISA_COUNTRIES); null — любые сделки этой услуги
  country     String?
  amount      Decimal     @db.Decimal(18, 2)
  currency    Currency    @default(USD)
  /// с какого дня (по Ташкенту, включительно) — по дате оплаты сделки
  fromDate    DateTime    @db.Date
  createdAt   DateTime    @default(now())
}

/// Особый процент менеджеру с отдельной услуги (например, 9% с виз в Таиланд) с даты fromDate — вместо обычного процента
/// с этих сделок (надбавка за план к нему не прибавляется). Удалить правило — сделки снова считаются по обычному проценту.
model SalaryRule {
  id             String         @id @default(cuid())
  userId         String
  serviceType    ServiceType
  /// страна визы (русское название из списка VISA_COUNTRIES); null — любые сделки этой услуги
  country        String?
  pct            Decimal        @db.Decimal(5, 2)
  commissionFrom CommissionBase @default(REVENUE)
  /// с какого дня (по Ташкенту, включительно) — по дате оплаты сделки
  fromDate       DateTime       @db.Date
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Условия зарплаты, действующие с месяца fromMonth до следующей записи: изменение не пересчитывает прошлые месяцы
model SalaryTerm {
  id             String         @id @default(cuid())
  userId         String
  /// первое число месяца (UTC)
  fromMonth      DateTime       @db.Date
  base           Decimal        @db.Decimal(18, 2)
  currency       Currency       @default(UZS)
  pct            Decimal        @db.Decimal(5, 2)
  bonusPct       Decimal        @default(0) @db.Decimal(5, 2)
  commissionFrom CommissionBase @default(REVENUE)
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fromMonth])
}

/// День, когда менеджер был «В работе» (включал переключатель), и сколько он работал — для деления процента с авиабилетов
model ShiftDay {
  userId    String
  /// ташкентская дата (UTC-ключ)
  day       DateTime @db.Date
  /// сколько секунд за день менеджер был «В работе» и действовал в CRM (меньше 4 часов — день не идёт в деление авиабилетов)
  activeSec Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

/// Выплата зарплаты менеджеру за месяц (можно частями): «Осталось» = к выплате за месяц − сумма выплат
model SalaryPayout {
  id          String   @id @default(cuid())
  userId      String
  /// месяц, за который выплата (первое число, UTC)
  month       DateTime @db.Date
  amount      Decimal  @db.Decimal(18, 2)
  currency    Currency @default(UZS)
  paidAt      DateTime @default(now())
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  user      User  @relation("PayoutManager", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PayoutAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, month])
}

/// Уведомление сотруднику (колокольчик): новый лид, просроченная задача, срок долга, продажа без себестоимости…
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// lead | task | cost | trip | chat | pool | ai | visa…
  type      String
  /// параметры текста (имя клиента, сумма…) — текст собирается на языке пользователя
  data      Json?
  link      String?
  /// ключ события — одно уведомление на событие (повторно не создаётся)
  key       String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, readAt, createdAt])
}

/// Вариант тура в подборке для клиента (отправляется ссылкой /o/{token} или текстом в чат)
model TourOffer {
  id            String    @id @default(cuid())
  leadId        String
  hotel         String
  stars         Int?
  destination   String?
  meal          String?
  dateFrom      DateTime? @db.Date
  nights        Int?
  adults        Int?
  children      Int?
  operator      String?
  /// цена туроператора и наценка агентства — клиент видит только сумму
  priceOperator Decimal   @db.Decimal(18, 2)
  markup        Decimal   @default(0) @db.Decimal(18, 2)
  currency      Currency  @default(USD)
  photoUrl      String?
  link          String?
  note          String?
  order         Int       @default(0)
  createdById   String?
  createdAt     DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// ИИ-ассистент в переписках Instagram/Telegram: отвечает клиенту, узнаёт номер и пожелания, передаёт менеджеру
model AiBotSettings {
  id           Int           @id @default(1)
  enabled      Boolean       @default(false)
  /// ключ Claude API (шифруется), вводит владелец в настройках
  apiKeyEnc    String?
  /// OFF_HOURS — только вне рабочего времени офиса; ALWAYS — всегда
  mode         String        @default("OFF_HOURS")
  channels     ChatChannel[] @default([TELEGRAM, INSTAGRAM])
  /// сведения об агентстве и правила для ассистента (адрес, услуги, цены, чего не обещать)
  instructions String        @default("")
  /// сколько ответов ассистент даёт в одной переписке, потом передаёт менеджеру
  maxReplies   Int           @default(20)
  lastError    String?
  lastUsedAt   DateTime?
}

/// Быстрые ответы в переписках (шаблоны). {name} заменяется именем клиента
model ChatTemplate {
  id        String   @id @default(cuid())
  title     String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Файл, отправленный клиенту из CRM. Доступен по случайному токену: Instagram сам скачивает вложение по ссылке
model ChatFile {
  id        String   @id @default(cuid())
  token     String   @unique
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

/// Этапы визовой заявки у визового специалиста
enum VisaStatus {
  NEW
  IN_PROGRESS
  /// оплачено, ожидается результат
  PAID_WAITING
  /// запрос дополнительных документов
  DOCS_REQUESTED
  APPROVED
  REJECTED
}

enum ApplicationSource {
  /// создана менеджером по продажам в CRM
  SALES
  /// пришла с сайта агентства
  WEBSITE
}

/// Заявка по лиду: виза в конкретную страну, авиабилеты, тур… У одного клиента их может быть несколько
model LeadService {
  id          String            @id @default(cuid())
  leadId      String
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        ServiceType
  /// страна визы (или направление)
  country     String?
  note        String?
  status      VisaStatus        @default(NEW)
  /// завершена: виза одобрена или отказ, у остальных — закрыта менеджером
  closed      Boolean           @default(false)
  source      ApplicationSource @default(SALES)
  /// когда визовая заявка передана визовым специалистам (с сайта — сразу)
  handedAt    DateTime?
  assigneeId  String?
  assignee    User?             @relation("ServiceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  statusAt    DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  /// Заявка с сайта Orient Visa: id заявки на сайте — ключ идемпотентности (docs/orient-visa-integration.md)
  externalId      String?   @unique
  externalNumber  String?
  externalUrl     String?
  visaType        String?
  urgent          Boolean   @default(false)
  /// оплачено на сайте, сум
  paidAmount      Decimal?  @db.Decimal(14, 2)
  agencyName      String?
  agencyInn       String?
  /// гражданство заявителя с сайта Orient Visa (ISO2, «IN»); нет — гражданин Узбекистана
  nationality     String?
  /// номер заявки на визовом портале страны
  portalReference String?
  /// анкета туристов и контакты с сайта — зашифрованный JSON (персональные данные)
  siteDataEnc     String?
  /// нужно (заново) забрать анкету и документы с сайта
  siteFetchNeeded Boolean   @default(false)
  siteFetchedAt   DateTime?
  siteFetchError  String?
  siteFetchTries  Int       @default(0)

  documents  LeadDocument[]
  events     VisaEvent[]
  siteEvents SiteEvent[]

  @@index([leadId])
  @@index([type, handedAt])
}

/// Какие документы нужны для заявки. Есть список для страны — берётся он, иначе общий для типа услуги (country = null)
model DocRequirement {
  id      String      @id @default(cuid())
  type    ServiceType
  country String?
  name    String
  order   Int         @default(0)

  @@index([type, country])
}

/// Документ клиента (паспорт, справка из банка, билет…). Файл хранится в базе CRM, открывается только сотрудникам с доступом
model LeadDocument {
  id            String      @id @default(cuid())
  serviceId     String
  service       LeadService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  docType       String
  fileName      String
  mime          String
  size          Int
  data          Bytes
  /// сохранён из переписки
  chatMessageId String?
  /// документ с сайта: его id на сайте и турист, к которому он относится
  externalId    String?
  travelerName  String?
  uploadedById  String?
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([serviceId])
  @@index([leadId])
}

/// История визовой заявки: смена этапа и комментарий визового специалиста
model VisaEvent {
  id        String      @id @default(cuid())
  serviceId String
  service   LeadService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    VisaStatus?
  comment   String?
  /// комментарий отправлен клиенту на сайт
  toClient  Boolean     @default(false)
  /// сообщение клиента с сайта Orient Visa
  fromClient Boolean    @default(false)
  /// id сообщения на сайте — повтор доставки не создаёт дубль
  externalId String?    @unique
  createdAt DateTime    @default(now())

  @@index([serviceId, createdAt])
}

/// Очередь событий CRM → сайт Orient Visa: отправка с повторами; id — X-Event-Id (сайт отсеивает повторы)
model SiteEvent {
  id        String      @id @default(cuid())
  serviceId String
  service   LeadService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payload   Json
  attempts  Int         @default(0)
  nextAt    DateTime    @default(now())
  sentAt    DateTime?
  lastError String?
  createdAt DateTime    @default(now())

  @@index([sentAt, nextAt])
  @@index([serviceId])
}

/// Вид визы в справочнике стран
enum VisaKind {
  /// электронная виза — приходит на почту
  EVISA
  /// стикер (наклейка) в паспорте — подача в посольство или визовый центр
  STICKER
  /// по прилёту
  ON_ARRIVAL
  /// виза не нужна
  VISA_FREE
}

/// Справочник виз: для гражданина страны citizenship — поездка в страну code: нужна ли виза, документы, сборы, цена, где и как подавать.
/// Читают все сотрудники; правят администратор и визовые специалисты.
model VisaCountry {
  id             String    @id @default(cuid())
  /// гражданство (паспорт) путешественника — код страны ISO, по умолчанию Узбекистан
  citizenship    String    @default("UZ")
  /// страна поездки — код ISO из списка стран мира (lib/world.ts); null — своё направление
  code           String?
  /// название страны поездки («Таиланд») или своё направление
  name           String
  visaKind       VisaKind?
  /// список документов — по одному в строке
  documents      String    @default("")
  /// консульский сбор — текстом, валюты бывают разные («90 €», «35 $ + сервисный сбор VFS 25 $»)
  consularFee    String?
  /// цена для клиента — первый вариант из prices (для старого кода и отчётов)
  salePrice      Decimal?  @db.Decimal(18, 2)
  saleCurrency   Currency  @default(USD)
  /// цены для клиента по вариантам визы: [{ label: "30 дней", price: 40, currency: "USD" }, { label: "1 год", price: 65, currency: "USD" }]
  prices         Json      @default("[]")
  /// срок оформления («5–7 рабочих дней»)
  processingTime String?
  /// срок действия визы и пребывания
  validity       String?
  /// где подавать: посольство, визовый центр, онлайн
  whereToApply   String?
  /// сайт подачи (анкета, e-visa)
  applyUrl       String?
  /// сайт записи в очередь
  appointmentUrl String?
  /// визовый сервис (VFS Global, BLS, TLScontact…), если подача через него
  visaCenter     String?
  notes          String?
  /// часть света — для фильтра: CIS, EUROPE, ASIA, MIDDLE_EAST, AFRICA, AMERICAS, OCEANIA
  region         String?
  /// официальные источники (сайты посольств, визовых сервисов) — по одной ссылке в строке
  sources        String?
  /// администратор проверил информацию; любая правка снимает отметку
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  updatedById    String?

  updatedBy  User? @relation("VisaCountryEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  verifiedBy User? @relation("VisaCountryVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([citizenship, code])
  @@unique([citizenship, name])
  @@index([region])
}
