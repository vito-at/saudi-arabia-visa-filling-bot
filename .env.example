# Скопируйте этот файл в .env и заполните значения.
# Файл .env НЕ отправляйте никому и не загружайте в интернет.

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать можно у @userinfobot). Только этот ID получит доступ к боту.
TELEGRAM_ADMIN_ID=

# --- Claude API (распознавание полей паспорта вне MRZ) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Шифрование файлов ---
# Сгенерировать ключ:  python -m db.keygen
# ВАЖНО: если потерять ключ, зашифрованные фото и данные расшифровать будет невозможно.
FILE_ENCRYPTION_KEY=

# Через сколько дней автоматически удалять фото паспортов и скриншоты
RETENTION_DAYS=14

# Папка для данных (база, зашифрованные файлы, отладочные HTML)
DATA_DIR=data

# --- Tesseract OCR (нужен для чтения MRZ) ---
# Путь к tesseract.exe (Windows), если его нет в PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Папка, где лежит mrz.traineddata (обычно tessdata внутри папки Tesseract)
TESSDATA_DIR=C:\Program Files\Tesseract-OCR\tessdata

# --- Портал и браузер ---
PORTAL_URL=
BROWSER_PROFILE_DIR=browser_profile
# Пауза между действиями в браузере, секунды (случайное значение в диапазоне)
ACTION_DELAY_MIN=0.6
ACTION_DELAY_MAX=1.8

# --- Фото для загрузки на портал ---
PORTAL_PHOTO_MAX_KB=200
PORTAL_PASSPORT_MAX_KB=500
